# DataBrief — unified Next.js app env vars (see migration plan: single Vercel
# project, Node backend replaces the Python/FastAPI + Celery/Redis stack).
# Copy the vars you need into frontend/.env.local for local dev.

# --- Database (Neon Postgres) ---
# DATABASE_URL: pooled connection string (hostname has "-pooler") — used by the
# app at runtime, since serverless functions open many short-lived connections.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/databrief?sslmode=require
# DIRECT_URL: unpooled connection string — used only by `prisma migrate`.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/databrief?sslmode=require

# --- Auth (NextAuth v5) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GITHUB_ID=...
GITHUB_SECRET=...

# --- LLM narration (tried in order, skipping any missing key; falls back to
# a deterministic template narrator if none are set or all calls fail) ---
GROQ_API_KEY=your_groq_api_key
MISTRAL_API_KEY=your_mistral_api_key
NVIDIA_API_KEY=your_nvidia_nim_api_key

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Storage (Neon Object Storage, S3-compatible, branch-scoped — mandatory
# now, no local-disk fallback since Vercel functions have no persistent disk).
# Generate credentials separately from your Postgres connection: Neon console
# → branch → Credentials (under APP BACKEND) → Create credential. Beta,
# AWS us-east-2 only as of this writing. ---
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech
NEON_STORAGE_ACCESS_KEY_ID=nak_live_...
NEON_STORAGE_SECRET_ACCESS_KEY=nsk_live_...
NEON_STORAGE_BUCKET_NAME=databrief
NEON_STORAGE_REGION=us-east-2

# --- Background jobs (Inngest — replaces Celery/Redis) ---
# Local development: set INNGEST_DEV=1 and run `npm run inngest:dev` from
# frontend in a second terminal. Production uses the cloud keys below.
INNGEST_DEV=1
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# --- Uploads ---
MAX_FILE_SIZE_MB=50
